# Copy to .env.local and fill in. Everything except ANTHROPIC_API_KEY is required.

# Pooled Postgres connection. Neon dashboard → your project → Connect →
# "Connection string", with "Connection pooling" ON. Used by the app at runtime.
DATABASE_URL=

# The same database with pooling OFF (host has no `-pooler` suffix). Neon
# dashboard → Connect → toggle "Connection pooling" off. Migrations need a
# direct session, so `pnpm db:migrate` and drizzle-kit read this one.
DATABASE_URL_UNPOOLED=

# OPTIONAL. console.anthropic.com → Settings → API keys. Leave it blank: the
# app is fully usable without it. The touchpoint drafter and the voice-note
# parser both ship deterministic template/regex implementations and fall back
# to them whenever this is unset, so every screen and the whole demo flow work
# on an empty value. Set it only to swap those for live Claude calls.
ANTHROPIC_API_KEY=

# Shared secret for the daily trigger cron (`0 6 * * *` → /api/cron/triggers,
# see vercel.json). Generate any long random string — `openssl rand -hex 32`.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
# Required everywhere, not just in production: the route fails closed, so with
# this unset it answers 401 locally too rather than leaving a write endpoint
# open to anyone who guesses the path. To hit it in dev:
#   curl -H "Authorization: Bearer $CRON_SECRET" localhost:3000/api/cron/triggers
# Set the same value on the Vercel project or the scheduled run will 401.
#
# NOTE: as of the last deploy this is set on Production but NOT on Preview —
# the Vercel CLI rejects its own suggested command for adding it. Preview
# deploys therefore 401 the cron route, which is the safe direction to fail,
# but it means a Preview URL cannot be used to smoke-test a trigger run.
CRON_SECRET=

# Shared secret the WOW OS Funnel presents when it reports a completed job to
# `POST /api/wow-os/job-completed`. Generate the same way — `openssl rand -hex 32`
# — and give the value to whoever builds the Funnel side; it is a secret we
# issue to them, not one we obtain from anywhere.
#
# Fails closed exactly like CRON_SECRET: unset means the endpoint 401s every
# request, locally included. To exercise ingest in dev, see the README's
# "Job completions" section.
#
# ⚠️  WOW OS DOES NOT CALL THIS YET. The endpoint is real, the caller is not:
# every row in `jobs` today came from `pnpm seed`. The contract WOW OS must
# implement is documented at the top of `lib/wow-os/jobs.ts`.
WOW_OS_WEBHOOK_SECRET=
