# Copy to .env.local and fill in. Everything except ANTHROPIC_API_KEY is required.

# Pooled Postgres connection. Neon dashboard → your project → Connect →
# "Connection string", with "Connection pooling" ON. Used by the app at runtime.
DATABASE_URL=

# The same database with pooling OFF (host has no `-pooler` suffix). Neon
# dashboard → Connect → toggle "Connection pooling" off. Migrations need a
# direct session, so `pnpm db:migrate` and drizzle-kit read this one.
DATABASE_URL_UNPOOLED=

# OPTIONAL. console.anthropic.com → Settings → API keys. Leave it blank: the
# app is fully usable without it. The touchpoint drafter and the voice-note
# parser both ship deterministic template/regex implementations and fall back
# to them whenever this is unset, so every screen and the whole demo flow work
# on an empty value. Set it only to swap those for live Claude calls.
ANTHROPIC_API_KEY=

# Shared secret for the daily trigger cron (`0 6 * * *` → /api/cron/triggers,
# see vercel.json). Generate any long random string — `openssl rand -hex 32`.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`; the route
# rejects requests without it, so set the same value in the Vercel project's
# environment variables or the scheduled run will 401.
CRON_SECRET=
